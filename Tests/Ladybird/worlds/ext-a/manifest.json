{
  "manifest_version": 3,
  "name": "worlds A",
  "version": "1",
  "permissions": ["scripting", "tabs", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "bg.js" },
  "content_scripts": [
    { "matches": ["http://127.0.0.1/page.html"], "js": ["cs-early.js"], "run_at": "document_start" },
    { "matches": ["http://127.0.0.1/page.html", "http://127.0.0.1/csp.html"], "js": ["cs.js"], "run_at": "document_idle" },
    { "matches": ["http://127.0.0.1/page.html"], "js": ["main.js"], "world": "MAIN", "run_at": "document_idle" },
    { "matches": ["http://127.0.0.1/loop.html*"], "js": ["cs-loop.js"], "run_at": "document_idle" },
    { "matches": ["http://127.0.0.1/frame.html"], "js": ["cs-frame.js"], "all_frames": true, "run_at": "document_idle" }
  ],
  "web_accessible_resources": [{ "resources": ["mod.js", "mod2.js", "inject.js"], "matches": ["http://127.0.0.1/*"] }]
}
