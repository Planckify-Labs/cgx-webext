{
  "manifest_version": 2,
  "name": "worlds Firefox",
  "version": "1",
  "browser_specific_settings": { "gecko": { "id": "worlds-ff@example.org" } },
  "permissions": ["tabs", "http://127.0.0.1/*"],
  "background": { "scripts": ["bg.js"] },
  "content_scripts": [{ "matches": ["http://127.0.0.1/page.html"], "js": ["cs.js"], "run_at": "document_idle" }]
}
