+static constexpr int PANEL_WIDTH = 340;
+static constexpr int PANEL_MAX_HEIGHT = 480;
+static constexpr int ACTION_ICON_SIZE = 18;
+static constexpr int ROW_ICON_SIZE = 20;
+// Chrome's limits for a popup's size.
