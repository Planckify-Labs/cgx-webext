+static void add_extension_menu_entries(Menu& menu, JsonArray const& items, ByteString const& extension_id, JsonObject const& target)
+{
+    items.for_each([&](JsonValue const& value) {
+        if (!value.is_object())
+            return;
+        auto const& item = value.as_object();
+        auto type = item.get_string("type"sv).value_or("normal"_string);
+        if (type == "separator"sv) {
+            menu.add_separator();
+            return;
+        }
+        auto title = item.get_string("title"sv).value_or({});
+        if (auto children = item.get_array("children"sv); children.has_value() && !children->is_empty()) {
+            auto submenu = Menu::create(title);
+            add_extension_menu_entries(*submenu, *children, extension_id, target);
+            menu.add_submenu(move(submenu));
+            return;
+        }
+        auto clicked = target;
+        clicked.set("extensionId"sv, MUST(String::from_byte_string(extension_id)));
+        clicked.set("itemId"sv, item.get_string("id"sv).value_or({}));
+        auto on_activate = [payload = clicked.serialized()] {
+            if (auto* manager = Application::extension_manager())
+                (void)manager->host_event("contextMenuClicked"sv, payload.bytes_as_string_view());
+        };
+        auto checkable = type == "checkbox"sv || type == "radio"sv;
+        auto action = checkable ? Action::create_checkable(title, ActionID::ExtensionMenuItem, move(on_activate)) : Action::create(title, ActionID::ExtensionMenuItem, move(on_activate));
+        if (checkable)
+            action->set_checked(item.get_bool("checked"sv).value_or(false));
+        action->set_enabled(item.get_bool("enabled"sv).value_or(true));
+        menu.add_action(move(action));
+    });
+}
+
+static void add_extension_menu_items(ViewImplementation& view, Menu& menu, bool is_editable, Optional<String> const& selected_text, Optional<URL::URL> const& link_url, Optional<URL::URL> const& src_url, Optional<StringView> media_type)
+{
+    auto* manager = Application::extension_manager();
+    if (!manager)
+        return;
+    JsonObject target;
+    target.set("tabId"sv, static_cast<i64>(view.view_id()));
+    target.set("frameId"sv, 0);
+    target.set("pageUrl"sv, view.url().serialize());
+    target.set("editable"sv, is_editable);
+    if (selected_text.has_value())
+        target.set("selectionText"sv, *selected_text);
+    if (link_url.has_value())
+        target.set("linkUrl"sv, link_url->serialize());
+    if (src_url.has_value())
+        target.set("srcUrl"sv, src_url->serialize());
+    if (media_type.has_value())
+        target.set("mediaType"sv, MUST(String::from_utf8(*media_type)));
+    auto request = target.serialized();
+    auto response = JsonValue::from_string(manager->host_event("contextMenuItems"sv, request.bytes_as_string_view()));
+    if (response.is_error() || !response.value().is_array() || response.value().as_array().is_empty())
+        return;
+    menu.add_separator();
+    response.value().as_array().for_each([&](JsonValue const& value) {
+        if (!value.is_object())
+            return;
+        auto const& entry = value.as_object();
+        auto extension_id = entry.get_string("extensionId"sv).value_or({}).to_byte_string();
+        auto items = entry.get_array("items"sv);
+        if (!items.has_value())
+            return;
+        if (items->size() == 1) {
+            add_extension_menu_entries(menu, *items, extension_id, target);
+            return;
+        }
+        auto submenu = Menu::create(entry.get_string("name"sv).value_or("Extension"_string));
+        add_extension_menu_entries(*submenu, *items, extension_id, target);
+        menu.add_submenu(move(submenu));
+    });
+}
